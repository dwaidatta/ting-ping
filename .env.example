# Server
TP_HOST=127.0.0.1
TP_PORT=8420

# Paths
TP_TARGETS_FILE=data/targets.json
TP_STATIC_DIR=static

# In-memory result buffer (per target) — no history is kept beyond this
TP_BUFFER_SIZE=60

# Allowed per-target polling interval range, in seconds
TP_INTERVAL_MIN_S=1
TP_INTERVAL_MAX_S=60
TP_DEFAULT_INTERVAL_S=5

# Per-check-method timeouts, in seconds
TP_CHECK_TIMEOUT_S=3.0
TP_PING_TIMEOUT_S=2.0
TP_HTTP_TIMEOUT_S=5.0
TP_TCP_TIMEOUT_S=3.0
TP_DNS_TIMEOUT_S=3.0

# HTTP check default scheme when a target doesn't specify one
TP_DEFAULT_HTTP_SCHEME=https

# Device-status probes
TP_DNS_PROBE_HOST=example.com
TP_GATEWAY_PROBE_PORT=80
TP_INTERNET_PROBE_HOST=1.1.1.1
TP_INTERNET_PROBE_PORT=443

# Public-identity lookup — the only outbound call this app makes on its own
# behalf. Set to 0 to keep every request inside your own network.
TP_PUBLIC_IP_LOOKUP=1
TP_PUBLIC_IP_URL=https://ipinfo.io/json
TP_PUBLIC_IP_TIMEOUT_S=4.0

TP_LOG_LEVEL=INFO
